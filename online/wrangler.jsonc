{
  "name": "smart-audit",
  "main": "cloudflare.mjs",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "rules": [{"type": "Text", "globs": ["**/*.sql"], "fallthrough": true}],
  "d1_databases": [{"binding": "DB", "migrations_dir": "./migrations"}],
  "kv_namespaces": [{"binding": "FILES"}]
}
